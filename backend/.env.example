DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/healthyfrog
SECRET_KEY=change-me-in-production-use-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=259200

# ──────────────────────────────────────────────────────────────────────
# Nutrition AI — выберите ОДИН из вариантов:
#
# A) PolzaAI (ВРЕМЕННО, OpenAI-совместимый; доступен из РФ, где
#    OpenRouter режется Cloudflare). Приоритетнее OpenRouter и Gemini.
#    Задайте POLZA_API_KEY и модель в AI_MODEL (см. docs Polza).
#
# B) OpenRouter (как в HealthyFrog 5.0, OpenAI-совместимый API)
#    Задайте OPENROUTER_API_KEY и модели с префиксом провайдера.
#
# C) Google Gemini (мульти-агентный pipeline, health_v2)
#    Задайте AI_API_KEY и/или GEMINI_API_*_KEY.
#
# Приоритет провайдера: Polza > OpenRouter > Gemini.
# Без ключей эндпоинты /nutrition/analyze/* отвечают HTTP 503.
# ──────────────────────────────────────────────────────────────────────

# --- PolzaAI (ВРЕМЕННОЕ решение; если ключ задан, остальные не нужны) ---
POLZA_API_KEY=
# Проверьте базовый URL по документации Polza перед запуском:
POLZA_BASE_URL=https://polza.ai/api/v1
# POLZA_SITE_URL=https://your-site.example
POLZA_APP_TITLE=Healthy Frog API
POLZA_TRANSCRIPTION_MODEL=whisper-1
# Модель Polza (текст/зрение) задаётся ниже через AI_MODEL / AI_VISION_MODEL.

# --- OpenRouter (приоритет: если ключ задан, Gemini не используется) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_SITE_URL=https://your-site.example
OPENROUTER_APP_TITLE=Healthy Frog API
OPENROUTER_TRANSCRIPTION_MODEL=whisper-1

# Модели для OpenRouter (примеры):
AI_MODEL=openai/gpt-4o-mini
# AI_VISION_MODEL=openai/gpt-4o-mini
# AI_AUDIO_MODEL=openai/gpt-4o-mini

# --- Gemini (если OPENROUTER_API_KEY пустой) ---
AI_API_KEY=
# AI_MODEL=gemini-2.0-flash
# AI_VISION_MODEL=gemini-2.0-flash
# AI_AUDIO_MODEL=gemini-2.0-flash

# GEMINI_API_CLASSIFY_KEY=
# GEMINI_API_READ_LABEL_KEY=
# GEMINI_API_IDENTIFY_FOOD_KEY=
# GEMINI_API_ESTIMATE_WEIGHT_KEY=
# GEMINI_API_ESTIMATE_KBJU_KEY=
